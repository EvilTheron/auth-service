POSTGRES_USER=auth
POSTGRES_PASSWORD=change_me
POSTGRES_DB=auth_service
# disable (local), require, or verify-full (managed databases such as Neon).
POSTGRES_SSL_MODE=disable
REDIS_PASSWORD=change_me

# Token signing key, at least 32 characters, otherwise the service refuses to start.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Reverse proxy addresses trusted to set X-Forwarded-For.
# Without this, every client appears as the proxy. Keep the default when there is no proxy.
FORWARDED_ALLOW_IPS=127.0.0.1

# Set to false in production to hide the interactive API documentation.
DOCS_ENABLED=true

# Refresh cookie is sent over HTTPS only. Set to false for local development over plain HTTP.
COOKIE_SECURE=true

# Seconds during which a just-rotated refresh token is still accepted as a retry.
# 0 (default) treats every reuse as theft.
REFRESH_REUSE_GRACE_SECONDS=0

# Brute-force protection thresholds (optional, defaults shown).
# LOGIN_IP_MAX_FAILURES=20
# LOGIN_IP_WINDOW_SECONDS=900
# LOGIN_ACCOUNT_FREE_ATTEMPTS=5
# LOGIN_LOCK_BASE_SECONDS=30
# LOGIN_LOCK_MAX_SECONDS=3600
# LOGIN_KNOWN_IP_MAX_FAILURES=5
# REGISTRATION_LIMIT_PER_HOUR=10
